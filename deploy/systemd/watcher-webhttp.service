[Unit]
Description=Watcher WebHTTP
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/watcher
ExecStart=/opt/watcher/bin/webhttp
Restart=on-failure
Environment=WATCHER_ENV=prod
Environment=WATCHER_INTERNAL_TOKEN=change-me-internal-token
Environment=WATCHER_WS_ORIGINS=https://watcher.example.com
# 工作目录 /opt/watcher；配置放 configs/config.yaml

[Install]
WantedBy=multi-user.target
