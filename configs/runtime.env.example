# 运行时环境变量示例（复制为 .env 或写入 NSSM/systemd Environment）
# 与 TLS / 服务化 / 内部鉴权相关

WATCHER_ENV=prod

# mqtt → webhttp / history 内部调用；生产务必改掉
WATCHER_INTERNAL_TOKEN=change-me-internal-token

# WSS Origin 白名单（逗号分隔，须含协议）。生产必填。
# 例：https://watcher.公司.com,https://admin.公司.com
WATCHER_WS_ORIGINS=https://localhost,https://127.0.0.1

# 可选服务地址
# WATCHER_HTTP_ADDR=:8080
# WATCHER_HISTORY_ADDR=:8082
# WATCHER_PUSH_ADDR=:8083
# WATCHER_BIZ_HTTP_ADDR=:8085
# WATCHER_HISTORY_URL=http://127.0.0.1:8082
# WATCHER_PUSH_URL=http://127.0.0.1:8083

# etcd（可选；空则跳过配置覆盖）
# WATCHER_ETCD_ENDPOINTS=127.0.0.1:2379
# 键示例：
#   /watcher/jwt/access_ttl=30m
#   /watcher/geofence/cooldown=10m
#   /watcher/history/retain_days=90
